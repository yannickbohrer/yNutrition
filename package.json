{
	"name": "ynutrition",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "npm run build && playwright test --project=setup --project=iphone --project=ipad-portrait --project=ipad-landscape",
		"db:generate": "drizzle-kit generate",
		"start": "node scripts/start.js",
		"import:swissfcd": "node scripts/import-swissfcd.js",
		"recovery": "node scripts/recovery.js",
		"backup": "node scripts/backup.js",
		"screenshots": "npm run build && playwright test --project=screenshots",
		"icons": "node scripts/dev/make-icons.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"exceljs": "^4.4.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"barcode-detector": "^3.2.3",
		"better-sqlite3": "^13.0.2",
		"chart.js": "^4.6.1",
		"drizzle-orm": "^0.45.4",
		"zxing-wasm": "^3.1.6"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.18.20": true,
		"better-sqlite3@13.0.3": true
	},
	"engines": {
		"node": ">=22"
	}
}
