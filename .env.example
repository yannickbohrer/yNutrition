# ---- Nutrition configuration ----
# Copy to .env and fill in. The values below are for a production install behind a reverse proxy
# on the same host (see docs/deployment/). For local development, use the block at the end.

# Public URL of the app (must match exactly what the browser shows; used for WebAuthn + cookies)
ORIGIN=https://nutrition.example.com
# WebAuthn relying party ID = the hostname (no scheme, no port). Passkeys are bound to it.
RP_ID=nutrition.example.com

# Host port the container is published on (the reverse proxy forwards to BIND_ADDRESS:PORT)
PORT=3000
# Host interface the port is published on. Keep 127.0.0.1 when the reverse proxy runs on the same
# host: Docker's published ports bypass firewalls like ufw, so 0.0.0.0 would expose plain HTTP to
# the internet. Use 0.0.0.0 only when the proxy is on another machine and a firewall restricts
# the port. See docs/deployment/README.md.
BIND_ADDRESS=127.0.0.1

# One-time token for the first passkey registration (/setup?token=...).
# Leave empty to have a random one generated and printed to the container logs on first start.
SETUP_TOKEN=
# Required: random secret (≥ 32 chars), e.g.: openssl rand -base64 48
# The container refuses to start without it.
SESSION_SECRET=

# Your contact e-mail, sent in the User-Agent to Open Food Facts (their API rules ask for it)
OFF_CONTACT_EMAIL=
# Optional: free USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=

# Optional: replace the Swiss food DB download URLs after the FSVO publishes a new version
# SWISSFCD_URL_DE=
# SWISSFCD_URL_EN=

# Incremental backups: the compose file mounts this host directory (default
# /var/backups/nutrition) at /backups and sets BACKUP_DIR=/backups. It must exist and belong to
# uid 1000 before the container starts: sudo install -d -m 750 -o 1000 -g 1000 /var/backups/nutrition
# BACKUP_HOST_DIR=/var/backups/nutrition

# Time zone of the container. Note: the app's day boundary (local midnight) is currently fixed to
# Europe/Zurich in src/lib/dates.ts, so other values only partly take effect.
TZ=Europe/Zurich

# --- local development (npm run dev): use these instead of the matching values above ---
# ORIGIN=http://localhost:5173
# RP_ID=localhost
# SETUP_TOKEN=dev-setup-token
# DATABASE_PATH=data/nutrition.db
# BACKUP_DIR=data/incremental-backups
