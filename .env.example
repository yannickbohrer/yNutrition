# ---- Nutrition configuration ----
# Public URL of the app (must match exactly what the browser shows; used for WebAuthn + cookies)
ORIGIN=https://nutrition.example.com
# WebAuthn relying party ID = the hostname (no scheme, no port)
RP_ID=nutrition.example.com

# Host port the container is published on (the reverse proxy forwards to HOST:PORT)
PORT=3000
# Interface to bind on the VM (0.0.0.0 = all interfaces, so the reverse proxy can reach it)
BIND_ADDRESS=0.0.0.0

# One-time token for the first passkey registration (/setup?token=...).
# Leave empty to have a random one generated and printed to the container logs on first start.
SETUP_TOKEN=
# Random secret (≥ 32 chars), e.g.: openssl rand -base64 48
SESSION_SECRET=

# Contact e-mail sent in the User-Agent to Open Food Facts (required by their API rules)
OFF_CONTACT_EMAIL=
# Optional: free USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=

# Time zone (a "day" is local midnight to midnight)
TZ=Europe/Zurich

# --- local development only ---
# DATABASE_PATH=data/nutrition.db
